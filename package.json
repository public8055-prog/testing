{
  "name": "urban-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "build": "next build",
    "postbuild": "node scripts/sanitize-build.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "db:init": "tsx --env-file-if-exists=.env.local scripts/db-init.ts",
    "test:db": "tsx scripts/db-smoke.ts",
    "test:platform": "tsx --test --test-concurrency=1 tests/marketplace.test.ts tests/workforce.test.ts tests/platform.test.ts tests/password-reset.test.ts tests/catalog-policy.test.ts",
    "test:payments": "node --experimental-strip-types --test tests/payment-signatures.test.mjs",
    "admin:promote": "tsx --env-file-if-exists=.env.local scripts/promote-admin.ts",
    "maintenance": "tsx --env-file-if-exists=.env.local scripts/maintenance.ts",
    "worker": "node --env-file-if-exists=.env.local scripts/container-entrypoint.mjs node --import tsx scripts/worker.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report artifacts/playwright-report",
    "db:catalog": "tsx --env-file-if-exists=.env.local scripts/sync-catalog.ts",
    "test:logic": "tsx --test --test-concurrency=1 tests/request-origin.test.ts tests/booking-logic.test.ts tests/payments.test.ts tests/stripe-payments.test.ts tests/payment-routing.test.ts tests/refunds.test.ts",
    "admin:bootstrap": "tsx --env-file-if-exists=.env.local scripts/bootstrap-admin.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate-to-mongodb.ts",
    "infra:up": "node scripts/infra-up.mjs",
    "test:operations": "tsx --test --test-concurrency=1 tests/service-operations.test.ts tests/redis.test.ts",
    "test:security": "tsx --test --test-concurrency=1 tests/http-security.test.ts tests/contact.test.ts tests/registration-consent.test.ts tests/password-hashing.test.ts tests/backups.test.ts",
    "test:auth": "tsx --test --test-concurrency=1 tests/auth-sessions.test.ts tests/password-hashing.test.ts tests/password-reset.test.ts",
    "test:all": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:queue": "tsx --test --test-concurrency=1 tests/service-queue.test.ts",
    "test:locations": "tsx --test tests/booking-location.test.ts",
    "test:admin": "tsx --test --test-concurrency=1 tests/admin-management.test.ts tests/platform.test.ts",
    "test:uploads": "tsx --test tests/uploads.test.ts",
    "test:client": "tsx --test --test-concurrency=1 tests/session-client.test.ts tests/gateway-origin.test.ts tests/container-config.test.ts tests/public-origin.test.ts tests/safe-redirect.test.ts",
    "admin:seed": "tsx --env-file-if-exists=.env.local scripts/bootstrap-admin.ts",
    "security:audit": "node scripts/security-audit.mjs",
    "backup": "tsx scripts/backup.ts",
    "backup:verify": "tsx scripts/verify-backup.ts",
    "backup:key": "tsx scripts/create-backup-key.ts",
    "export:source": "node scripts/export-source.mjs"
  },
  "dependencies": {
    "@next/env": "^16.4.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "argon2": "^0.45.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.45.0",
    "mongodb": "^7.7.0",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "^6.3.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
