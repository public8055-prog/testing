# Development defaults for docker-compose.infra.yml only.
# Copy to .env.local only when that file does not already exist.
# These loopback services have no authentication and must never be exposed publicly.
APP_URL=http://localhost:3000
COOKIE_SECURE=false
# Required for sessions. Generate a fresh 32-byte random key, encode it as base64,
# and inject it at runtime. Never use a published example value or NEXT_PUBLIC_.
AUTH_JWT_SECRET=
# Local Compose publishes only on loopback; optional --profile app uses this port.
APP_PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true
MONGODB_DB=urbankare_mongo
MONGODB_POOL_SIZE=20
REDIS_URL=redis://127.0.0.1:6380
# Optional: a unique prefix per environment sharing the Redis service.
# The default is derived from MONGODB_DB.
REDIS_KEY_PREFIX=
TRUST_PROXY=false
# Host npm dev/start/install automatically manage only the loopback endpoints above.
# Set false when you manage those local services yourself. External endpoints are untouched.
AUTO_START_LOCAL_INFRA=true

# Public business details; never invent these. Keep launch/indexing disabled until reviewed.
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
BUSINESS_SUPPORT_EMAIL=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_EMAIL=
# Digits only, with country code (no personal number is shipped as a default).
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_LAUNCH_READY=false
# Search Console ownership verification, supplied by your verified domain property.
GOOGLE_SITE_VERIFICATION=
# Analytics is intentionally disabled. No GA scripts load until explicitly implemented/configured.

# Production: inject an authenticated TLS MongoDB replica-set URI, an authenticated
# rediss:// URL, a production database name, HTTPS APP_URL and COOKIE_SECURE=true.
# Do not pass this development file to production Compose.

# Gateway secrets stay server-side. Pay-after-service bookings begin unpaid.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Card checkout preference when configured; UPI requires Razorpay.
PAYMENT_GATEWAY_PREFERENCE=razorpay

# Optional password-reset adapter: HTTPS POST {to, subject, text},
# Authorization: Bearer EMAIL_DELIVERY_TOKEN. Empty means recovery is unavailable.
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=

# Encrypted MongoDB snapshots: opt in only after key/storage/restore verification.
# Configure exactly one key source. Never commit key values or put them in public variables.
BACKUPS_ENABLED=false
BACKUP_DIRECTORY=.data/backups/encrypted
BACKUP_KEY_FILE=
BACKUP_ENCRYPTION_KEY=
BACKUP_MAX_BYTES=104857600
# Production Compose fixes the worker destination to its durable backup volume.
# A BACKUP_KEY_FILE used in a container must be a protected, read-only mounted container path.

# Private administrator setup is a trusted CLI action. Inject SEED_ADMIN_EMAIL,
# SEED_ADMIN_PASSWORD (at least 10 characters), and optional SEED_ADMIN_NAME only
# into a one-shot seed command. They are not forwarded into long-running containers.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Platform Administrator
# Legacy private alias provisioning remains available: inject ADMIN_BOOTSTRAP_ID
# and ADMIN_BOOTSTRAP_PASSWORD only for npm run admin:bootstrap; do not store
# administrator credentials in this example, application source or public variables.
# Optional ADMIN_BOOTSTRAP_NAME controls the display name.

# Optional HTTPS OpenStreetMap-compatible tile endpoint. Public by design; never put
# a private API key here. The map loads only after the user chooses to load it.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
